diff -ruN sp_a/train.py sp_b/train.py
--- sp_a/train.py	1969-12-31 19:00:00.000000000 -0500
+++ sp_b/train.py	2026-10-28 15:06:05.374682872 -0400
@@ -0,0 +1,64 @@
+#!python
+# Training entry point. Mirrors test.py; the public repo ships training_pipeline.py but no train.py / train.yaml.
+# https://github.com/BytedProtein/ByProt/blob/dd279dc85f76ee2c28c819b71bf3911b90159f0a/train.py
+import os
+import sys
+import warnings
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import importlib.abc
+import importlib.machinery
+import pytorch_lightning  # noqa: F401  (must import before anything is stubbed: PL probes find_spec("torchtext"))
+
+
+class _StubFinder(importlib.abc.MetaPathFinder, importlib.abc.Loader):
+    """Last-resort finder: packages that are imported at module level somewhere in spurs/ but never used on the
+    training path (torchtext, IPython, matplotlib, ...) resolve to MagicMock modules when they are not installed."""
+
+    def __init__(self, roots):
+        self.roots = set(roots)
+
+    def find_spec(self, name, path=None, target=None):
+        if name.split(".")[0] in self.roots:
+            return importlib.machinery.ModuleSpec(name, self, is_package=True)
+
+    def create_module(self, spec):
+        module = MagicMock(name=spec.name)
+        module.__spec__, module.__path__ = spec, []
+        return module
+
+    def exec_module(self, module):
+        pass
+
+
+sys.meta_path.append(_StubFinder(["torchtext", "IPython", "matplotlib", "seaborn", "wandb", "biotite", "dotenv"]))
+
+try:
+    import pyrootutils
+    root = pyrootutils.setup_root(search_from=__file__, indicator=[".git", "pyproject.toml"], pythonpath=True, dotenv=True)
+except ImportError:
+    root = Path(__file__).resolve().parent
+    os.environ.setdefault("PROJECT_ROOT", str(root))
+    sys.path.insert(0, str(root))
+
+import hydra
+from omegaconf import DictConfig
+
+
+@hydra.main(config_path=f"{root}/configs", config_name="train.yaml")
+def main(config: DictConfig):
+    from spurs import utils
+    from spurs.training_pipeline import train
+
+    # `experiment_path=<dir>` re-loads <dir>/.hydra/config.yaml AND points log_dir at <dir>, i.e. the run writes its
+    # checkpoints, .hydra/ and config_tree.log into that directory. Leave it null to train from configs/train.yaml.
+    if config.get("experiment_path"):
+        warnings.warn(f"experiment_path set: this run will write into {config.experiment_path}")
+        config = utils.resolve_experiment_config(config)
+    config = utils.extras(config)
+    return train(config)
+
+
+if __name__ == "__main__":
+    main()
