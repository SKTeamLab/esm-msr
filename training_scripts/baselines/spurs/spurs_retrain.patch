diff -ruN sp_a/spurs/datamodules/datasets/items.py sp_b/spurs/datamodules/datasets/items.py
--- sp_a/spurs/datamodules/datasets/items.py	1969-12-31 19:00:00.000000000 -0500
+++ sp_b/spurs/datamodules/datasets/items.py	2026-10-28 15:57:16.794537799 -0400
@@ -0,0 +1,94 @@
+import json
+import os
+
+import numpy as np
+import pandas as pd
+import torch
+
+from spurs import utils
+from .megascale import MegaScaleDataset
+from .megascale_multi import MegaScaleDoubleDataset
+from .utils import parse_pdb
+
+log = utils.get_logger(__name__)
+
+
+class ItemsTableDataset(MegaScaleDataset):
+    """Single-mutation Megascale data from prepared item tables instead of mega_splits.pkl + the raw Tsuboyama csv.
+
+    `data_dir` holds items_{train,val,test}.csv (columns code, wt_seq, mut_type, ddG_ML, kind; ddG_ML is positive =
+    stabilizing) and pdbs/<code>.pdb, one structure per library whose sequence equals the library's wt_seq. This is the
+    data contract of the ESM-MSR-matched baselines, so SPURS sees exactly the rows ThermoMPNN and MutateEverything do.
+    A mutant-background library (kind native_cond, e.g. 2K52_L42A) is its own protein with the background residue already in
+    wt_seq. Batching, targets (ddG = -ddG_ML) and featurisation are MegaScaleDataset's.
+
+    Args:
+        data_dir: directory with the item tables and pdbs/
+        split: train | val | test
+        kinds: which `kind` values to keep (doubles are for SPURS-multi)
+        structure_json: cache of the parsed pdbs/ (written on first use; keep it outside data_dir)
+        max_libraries: smoke tests
+    """
+
+    def __init__(self, data_dir, split='train', kinds=('single', 'native_cond'), structure_json=None,
+                 mut_seq=False, single_mut=False, std_ratio=0.75, loss_ratio=1., train_ratio=1., max_libraries=0):
+        torch.utils.data.Dataset.__init__(self)
+        self.split = split
+        df = pd.read_csv(os.path.join(data_dir, f'items_{split}.csv'), low_memory=False)
+        df = df[df['kind'].isin(list(kinds))].reset_index(drop=True)
+        df = df[np.isfinite(df['ddG_ML'])]
+        self.wt_seqs, self.mut_rows = {}, {}
+        for code, g in df.groupby('code', sort=True):
+            wt_seq = g['wt_seq'].iloc[0]
+            assert (g['wt_seq'] == wt_seq).all(), f'{code}: several wild-type sequences'
+            g = g.reset_index(drop=True)
+            pos = g['mut_type'].str[1:-1].astype(int) - 1
+            assert all(wt_seq[p] == m[0] for p, m in zip(pos, g['mut_type'])), f'{code}: mut_type does not match wt_seq'
+            g['aa_seq'] = [wt_seq[:p] + m[-1] + wt_seq[p + 1:] for p, m in zip(pos, g['mut_type'])]
+            self.wt_seqs[code + '.pdb'] = wt_seq
+            self.mut_rows[code + '.pdb'] = g
+        self.wt_names = list(self.wt_seqs)[:max_libraries or None]
+        log.info(f'{split}: {len(self.wt_names)} libraries, {sum(len(self.mut_rows[n]) for n in self.wt_names)} mutations')
+
+        self.structure_path = os.path.join(data_dir, 'pdbs')
+        structure_json = structure_json or os.path.join(data_dir, '..', 'parsed_structure.json')
+        os.makedirs(os.path.dirname(os.path.abspath(structure_json)), exist_ok=True)
+        parse_pdb(self.structure_path, structure_json)
+        with open(structure_json) as f:
+            self.json_dataset = json.load(f)
+        self.mut_seq, self.single_mut = mut_seq, single_mut
+        self.std_ratio, self.loss_ratio, self.train_ratio = std_ratio, loss_ratio, train_ratio
+
+
+class ItemsTableDoubleDataset(MegaScaleDoubleDataset):
+    """SPURS-multi data (two-mutation variants, `kind == double`) from the same item tables; item layout, targets and
+    featurisation are MegaScaleDoubleDataset's (mut_ids [N, 2], append_tensors [N, 4], ddG = -ddG_ML)."""
+
+    def __init__(self, data_dir, split='train', kinds=('double',), structure_json=None, max_libraries=0):
+        torch.utils.data.Dataset.__init__(self)
+        self.split = split
+        df = pd.read_csv(os.path.join(data_dir, f'items_{split}.csv'), low_memory=False)
+        df = df[df['kind'].isin(list(kinds)) & np.isfinite(df['ddG_ML'])].reset_index(drop=True)
+        self.wt_seqs, self.mut_rows = {}, {}
+        for code, g in df.groupby('code', sort=True):
+            wt_seq = g['wt_seq'].iloc[0]
+            assert (g['wt_seq'] == wt_seq).all(), f'{code}: several wild-type sequences'
+            g = g.reset_index(drop=True)
+            seqs = []
+            for mt in g['mut_type']:
+                s = list(wt_seq)
+                for m in mt.split(':'):
+                    assert wt_seq[int(m[1:-1]) - 1] == m[0], f'{code}: {mt} does not match wt_seq'
+                    s[int(m[1:-1]) - 1] = m[-1]
+                seqs.append(''.join(s))
+            g['aa_seq'] = seqs
+            self.wt_seqs[code + '.pdb'] = wt_seq
+            self.mut_rows[code + '.pdb'] = g
+        self.wt_names = list(self.wt_seqs)[:max_libraries or None]
+        log.info(f'{split}: {len(self.wt_names)} libraries, {sum(len(self.mut_rows[n]) for n in self.wt_names)} double mutants')
+        self.structure_path = os.path.join(data_dir, 'pdbs')
+        structure_json = structure_json or os.path.join(data_dir, '..', 'parsed_structure.json')
+        os.makedirs(os.path.dirname(os.path.abspath(structure_json)), exist_ok=True)
+        parse_pdb(self.structure_path, structure_json)
+        with open(structure_json) as f:
+            self.json_dataset = json.load(f)
