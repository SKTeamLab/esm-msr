+
+
+@register_datamodule('items')
+class ItemsModule(LightningDataModule):
+    """Same loop as MegaScaleModule, with ItemsTableDataset in place of the mega_splits.pkl dataset."""
+
+    def __init__(self, alphabet, data_dir: str, structure_json: Optional[str] = None, kinds=('single', 'native_cond'),
+                 batch_size: int = 1, num_workers: int = 0, pin_memory: bool = False, max_libraries: int = 0, multi: bool = False) -> None:
+        super().__init__()
+        self.save_hyperparameters(logger=False)
+        self.alphabet = None
+
+    def _dataset(self, split):
+        h = self.hparams
+        if h.multi:  # SPURS-multi: two-mutation variants
+            return ItemsTableDoubleDataset(h.data_dir, split=split, structure_json=h.structure_json, max_libraries=h.max_libraries)
+        return ItemsTableDataset(h.data_dir, split=split, kinds=tuple(h.kinds), structure_json=h.structure_json,
+                                 max_libraries=h.max_libraries)
+
+    def setup(self, stage: Optional[str] = None):
+        self.alphabet = Alphabet(**self.hparams.alphabet)
+        self.collate_batch = self.alphabet.featurize
+        if stage == 'fit':
+            self.train_dataset, self.valid_dataset = self._dataset('train'), self._dataset('val')
+        elif stage == 'test':
+            self.test_dataset = self._dataset('test')
+
+    def _loader(self, dataset, shuffle):
+        h = self.hparams
+        return DataLoader(dataset, batch_size=h.batch_size, shuffle=shuffle, num_workers=h.num_workers,
+                          pin_memory=h.pin_memory, collate_fn=self.collate_batch)
+
+    def train_dataloader(self):
+        return self._loader(self.train_dataset, True)
+
+    def val_dataloader(self):
+        return self._loader(self.valid_dataset, False)
+
+    def test_dataloader(self):
+        return self._loader(self.test_dataset, False)
